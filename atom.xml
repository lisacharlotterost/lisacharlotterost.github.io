---
layout: null
permalink: /atom.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom"
      xmlns:media="http://search.yahoo.com/mrss/">
  <title>{{ site.title | xml_escape }}</title>
  <link href="{{ site.url }}{{ site.baseurl }}/atom.xml" rel="self"/>
  <link href="{{ site.url }}{{ site.baseurl }}/"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url | xml_escape }}</id>
  <author>
    <name>{{ site.author.name | xml_escape }}</name>
    {% if site.author.email %}
    <email>{{ site.author.email | xml_escape }}</email>
    {% endif %}
  </author>

 {% for post in site.posts %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ site.url }}{{ post.url | xml_escape }}" rel="alternate"/>
    <id>{{ site.url }}{{ post.id }}</id>
    <updated>{{ post.date | date_to_xmlschema }}</updated>

    {% if post.external %}
      {% capture external_html %}
        <p>
          I posted this article somewhere else (most likely on the Datawrapper blog),
          that's why you don't see anything here in your RSS reader.
          <b><a href="{{ post.external | xml_escape }}">Read this article here!</a></b>
        </p>
      {% endcapture %}
      <content type="html"><![CDATA[{{ external_html }}]]></content>

    {% elsif post.content contains "dwcdn.net" %}
      {% assign after_dw = post.content | split: "dwcdn.net/" | last %}
      {% assign chart_id = after_dw | split: "/" | first %}
      {% assign dw_image = "https://datawrapper.dwcdn.net/" | append: chart_id | append: "/plain.png" %}
      {% assign chart_page = "https://datawrapper.dwcdn.net/" | append: chart_id | append: "/" %}

      {% capture entry_html %}
        <p><a href="{{ chart_page | xml_escape }}">View interactive chart on Datawrapper</a></p>
        <p><img src="{{ dw_image | xml_escape }}" alt="{{ post.title | xml_escape }}" /></p>
        <hr />
        {{ post.content }}
      {% endcapture %}

      {% assign entry_html_protected = entry_html | replace: "]]>", "]]]]><![CDATA[>" %}
      <content type="html"><![CDATA[{{ entry_html_protected }}]]></content>

    {% else %}
      {% assign normal_html = post.excerpt | default: post.content %}
      {% assign normal_html_protected = normal_html | replace: "]]>", "]]]]><![CDATA[>" %}
      <content type="html"><![CDATA[{{ normal_html_protected }}]]></content>
    {% endif %}
  </entry>
{% endfor %}
</feed>
