---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="/rss-style.xsl"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Lisa Charlotte Muth – Blog</title>
    <description>{% if site.description %}{{ site.description }}{% endif %}</description>    
    <link>{{ site.url }}</link>
    <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml" />
    
    {% for post in site.posts limit:10 %}
      <item>
        <title>{{ post.title | xml_escape }}</title>
        <pubDate>{{ post.date | date: "%a, %d %b %Y" }}</pubDate>
        <link>{% if post.external %}{{ post.external }}{% else %}{{ site.url }}{{ post.url }}{% endif %}</link>
        <guid isPermaLink="true">{% if post.external %}{{ post.external }}{% else %}{{ site.url }}{{ post.url }}{% endif %}</guid>
        
       <description><![CDATA[
		  {% if post.external %}
		    <div style="background-color: #fff; padding: 20px; border: 2px solid #cc0000; margin: 20px 0; font-family: sans-serif;">
		      <strong style="display: block; margin-bottom: 10px;">📝 This blog post lives somewhere else</strong>
		      <p>I posted this article elsewhere (most likely on the Datawrapper blog), which is why you don't see the full content here.</p>
		      <a href="{{ post.external }}">Read the full article on the original site &#8594;</a>
		    </div>
		    {% if post.summary %}<p>{{ post.summary }}</p>{% endif %}
		  {% else %}
		    {{ post.content }}
		  {% endif %}
		]]></description>
      </item>
    {% endfor %}
  </channel>
</rss>
